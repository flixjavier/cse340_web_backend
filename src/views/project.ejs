<%- include('partials/header') %>
  <main>
    <h1><%= project.title %></h1>
    <p>
      <%= project.description %>
    </p>
    <p>Date: <%= new Date(project.project_date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC'
    }) %></p>
    <p>Location: <%= project.location %></p>
    <p>Organization: 
      <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>
    
    <% if (user) { %>
      <section class="volunteer-section" aria-labelledby="volunteer-heading">
        <h2 id="volunteer-heading">Volunteer</h2>
        <% if (isVolunteering) { %>
          <p>You are volunteering for this project.</p>
          <form method="post" action="/project/<%= project.project_id %>/volunteer/remove">
            <button type="submit">Remove my signup</button>
          </form>
        <% } else { %>
          <form method="post" action="/project/<%= project.project_id %>/volunteer">
            <button type="submit">Volunteer for this project</button>
          </form>
        <% } %>
      </section>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
      <a class="add-organization-link" href="/edit-project/<%=project.project_id %>">
                Edit a project
      </a>
    <% } %>
    <section aria-labelledby="categories-heading">
      <h2 id="categories-heading">Categories</h2>
      
      <% if (user && user.role_name === 'admin') { %>
        <a class="add-organization-link" href="/assign-categories/<%= project.project_id %>">Update Categories</a>
      <% } %>
      <ul class="category-tags">
        <% categories.forEach(category =>
          { %>
              <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.category_name %>
                </a>
              </li>
            <%
        }); %>
      </ul>
    </section>
  </main>

<%- include('partials/footer') %>
