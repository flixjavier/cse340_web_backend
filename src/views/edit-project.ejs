<%- include('partials/header') %>
<main class="organization-form-page">
    <h1><%= title %></h1>

    <form class="organization-form" action="/edit-project/<%= projectDetails.project_id%>" method="POST">
      <div class="form-group">
        <label for="title">Project Title</label>
        <input
          type="text"
          id="title"
          name="title"
          value="<%= projectDetails.title%>"
          required maxlength="150"
        />
      </div>

      <div class="form-group">
        <label for="description" >Description</label>
        <textarea
          id="description"
          name="description"
          rows="5"
          required maxlength = "500"
        ><%= projectDetails.description%></textarea>
      </div>

      <div class="form-group">
        <label for="location">Location:</label>
        <input
          type="text"
          id="location"
          name="location"
          value="<%=projectDetails.location%>"
          required maxlength="200"
        />
      </div>
      
      <div class="form-group">
        <label for="date">Date:</label>
        <input
          type="date"
          id="date"
          name="date"
          value="<%= projectDetails.form_date %>"
          required
        />
      </div>

      <div class="form-group">
        <label for="organizationId">Organization:</label>
        <select
          id="organizationId"
          name="organizationId"
          required>
          <option
            value=""
          >Select an organization</option>
            <% organizations.forEach(org=>{ %>
              <option
                value = "<%=org.organization_id%>"
                <%=org.organization_id === projectDetails.organization_id ? 'selected': ''  %>
                >
                <%=org.name%>
              </option><% });%>
            
        </select>
      </div>

      <div class="form-actions">
        <button type="submit">Update Project</button>
        <a href="/projects">Cancel</a>
      </div>
    </form>

</main>
<%- include('partials/footer') %>
