<%- include('partials/header') %>

<main>
    <section class="projects-section" aria-labelledby="projects-heading">
        <h1 id="projects-heading"><%= title %></h1>
        <p>Find upcoming service opportunities supported by our partner organizations.</p>
        <a class="add-project-link" href="/new-project">Add a New Service Project</a>

        <div class="projects-list">
            <% projects.forEach(project => { %>
                <% const dateValue = new Date(project.project_date); %>
                <% const formattedDate = dateValue.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    timeZone: 'UTC'
                }); %>

                <article class="project-card">
                    <time class="project-date" datetime="<%= project.project_date %>">
                        <%= formattedDate %>
                    </time>

                    <div class="project-details">
                        <h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
                        <p>
                            Sponsored by
                            <span><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></span>
                        </p>
                    </div>
                </article>
            <% }); %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>


