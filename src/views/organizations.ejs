    <main>
        <section class="organizations-section">
            <h1><%= title %></h1>
            <p>Here are a few of our partner organizations:</p>

            <div class="organizations-container">
            <article class="organization-card">
                <img src="/images/brightfuture-logo.png" alt="BrightFuture Builders logo">
                <div>
                <h2>BrightFuture Builders</h2>
