<%- include('partials/header') %>
    <main>
        <section class="organizations-section">
            <h1><%= title %></h1>
            <p>Here are a few of our partner organizations:</p>

            <div class="organizations-container">
                <% organizations.forEach(org=>{ %>
                    <article class="organization-card">
                        <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
                        <div>
                            <h2><%= org.name %></h2>
                            <p><%= org.description %></p>
                            <a href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a>
                        </div>
                    </article>
                <% }) %>
            </div>
        </section>
    </main>

<%- include('partials/footer') %>
