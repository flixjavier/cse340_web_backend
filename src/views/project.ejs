<%- include('partials/header') %>
<main>
  <h1><%= project.title %></h1>
  <p>
    <%= project.description %>
  </p>
  <p>Date: <%= new Date(project.project_date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC'
  }) %></p>
  <p>Location: <%= project.location %></p>
  <p>Organization: 
    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
  </p>
</main>

<%- include('partials/footer') %>
